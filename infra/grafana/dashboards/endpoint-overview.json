    "list": [
      {
        "name": "os",
        "label": "OS",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(system_uptime_seconds, os_type)",
          "refId": "os-var",
          "qryType": 1
        },
        "definition": "label_values(system_uptime_seconds, os_type)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
