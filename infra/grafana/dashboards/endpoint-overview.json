{
  "uid": "endpoint-overview",
  "title": "Endpoint Overview",
  "description": "Device and app performance reported by the endpoint agent.",
  "tags": [
    "endpoint",
    "opentelemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
