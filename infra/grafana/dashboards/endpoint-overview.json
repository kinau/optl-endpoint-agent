    {
      "type": "table",
      "title": "Hosts",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One row per host: hardware, current load, uptime and time since the agent last reported.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name, host_type, os_description) (topk by (host_name) (1, timestamp(target_info{job=\"endpoint-agent\", host_name=~\"$host\", os_type=~\"$os\"})))",
          "legendFormat": "__auto",
          "refId": "INFO",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name) (1 - system_cpu_utilization_ratio{cpu_mode=\"idle\", host_name=~\"$host\", os_type=~\"$os\"})",
          "legendFormat": "__auto",
          "refId": "CPU",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name) (system_memory_utilization_ratio{system_memory_state=\"used\", host_name=~\"$host\", os_type=~\"$os\"})",
          "legendFormat": "__auto",
          "refId": "MEM",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name) (system_filesystem_utilization_ratio{host_name=~\"$host\", os_type=~\"$os\"})",
          "legendFormat": "__auto",
          "refId": "DISK",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name) (system_uptime_seconds{host_name=~\"$host\", os_type=~\"$os\"})",
          "legendFormat": "__auto",
          "refId": "UP",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host_name) (time() - timestamp(endpoint_agent_uptime_seconds{host_name=~\"$host\", os_type=~\"$os\"}))",
          "legendFormat": "__auto",
          "refId": "SEEN",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
