        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(system_uptime_seconds{os_type=~\"$os\"}, host_name)",
          "refId": "host-var",
          "qryType": 1
        },
        "definition": "label_values(system_uptime_seconds{os_type=~\"$os\"}, host_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
